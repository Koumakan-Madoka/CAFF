# Copy this file to .env.local for local development.
# `npm run start` and `npm run start:dev` auto-load .env.local if it exists.
# Existing process environment variables still win over values from the file.

CHAT_APP_HOST=127.0.0.1
CHAT_APP_PORT=3100

# Optional external planner attribution (default: External Planner).
# This is not a Room agent or a credential.
# CAFF_PLANNER_NAME=Claude Code
# Credentials rotate on each successful server start, never printed in logs.
# Default directory: %LOCALAPPDATA%/CAFF/planner/ on Windows;
# ${XDG_STATE_HOME:-~/.local/state}/caff/planner/ on POSIX.
# Filename: planner-<sha256(normalized bind host)>-<actual port>.json.
# Override with an absolute path; the same owner-only/ancestor checks apply.
# CAFF_PLANNER_CREDENTIAL_FILE=

# Embedded planner terminal (on by default, loopback binding only).
# Unset or 1/true/on/yes enables; 0/false/off/no disables (trimmed, case-insensitive).
# Other values, including empty, disable with planner_terminal_flag_invalid.
# Requires official Claude Code >=2.1.310. No automatic installation/update.
# Changing shared instance configuration/restarting requires user authorization.
# Wake-ups are separately opt-in per room, consume CLI configured usage (4/hour),
# and require verified 2.1.x >=2.1.310 with whitespace-free Node/adapter paths.
# New major/minor or unsupported paths disable wakes until a new planner gate.
# CAFF_PLANNER_TERMINAL=0
# Instance-wide planner process slots, read once at startup; default 4 when unset.
# Positive decimal safe integer 1..9007199254740991, trimmed, no leading zeros.
# Empty/invalid values block planner startup with planner_process_limit_invalid;
# the terminal entry stays visible on loopback, normal CAFF routes stay usable.
# Shared by interactive/retained, starting/stopping, unknown leases and wake-ups.
# No eviction/hot reload. Raising this is NOT evidence of machine capacity;
# planners may spawn descendants. The separate 4 wake-ups/hour/room is unchanged.
# CAFF_PLANNER_MAX_PROCESSES=4
# Optional single executable path (not shell text); .js/.cjs/.mjs use Node.
# CAFF_CLAUDE_CLI=
# Child processes inherit path/proxy variables only, not provider keys or
# CLAUDE_CODE_* preferences. Put user-specific CLI env in ~/.claude/settings.json.

# Optional outbound proxy whitelist (takes priority over NODE_USE_ENV_PROXY).
# Comma-separated hostnames; a bare domain matches itself and all subdomains
# ("foo.com" covers "a.foo.com"), an optional ":port" suffix restricts the
# entry to that port. When set, only requests to these hosts go through
# HTTP(S)_PROXY; everything else (domestic providers, localhost) connects
# directly and keeps working even if the proxy is down.
# PROXY_ONLY_HOSTS=auth.openai.com,chatgpt.com,api.openai.com,api.anthropic.com,models.dev,api.github.com
# HTTP_PROXY=http://127.0.0.1:17890
# HTTPS_PROXY=http://127.0.0.1:17890

# Optional conversation memory automation
# CAFF_SKILL_DRAFT_AUTO_CREATE=false
# CAFF_SKILL_DRAFT_GENERATION_MODE=rules  # rules | model | auto
# CAFF_SKILL_DRAFT_PROVIDER=
# CAFF_SKILL_DRAFT_MODEL=
# CAFF_SKILL_DRAFT_THINKING=
# CAFF_SKILL_DRAFT_MODEL_TIMEOUT_MS=90000

# Optional local overrides
# PI_CODING_AGENT_DIR=
# PI_SQLITE_PATH=
# No built-in provider/model fallback. These explicitly select runtime defaults.
# Digest/title/Recovery require a saved System Services scribe selection instead.
# PI_PROVIDER=
# PI_MODEL=
# PI_THINKING=
# PI_HEARTBEAT_TIMEOUT_MS=60000  # host process liveness
# PI_PROGRESS_TIMEOUT_MS=600000 # no model/tool progress; PI_IDLE_TIMEOUT_MS is a legacy alias
# PI_TIMEOUT_MS=10800000        # absolute run limit (3 hours)

# Optional browser automation for agents.
# Set explicitly to enable; if unset, CAFF does not expose browser tools.
# CAFF_BROWSER_CLI_PATH=../playwright-cli/playwright-cli.js

# Feishu integration
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Webhook mode only
FEISHU_VERIFICATION_TOKEN=
# Optional fallback when GET /open-apis/bot/v3/info is unavailable
# FEISHU_BOT_OPEN_ID=
# Inbound mode: webhook | long-connection
# FEISHU_CONNECTION_MODE=webhook
# Optional official SDK long connection log level: fatal | error | warn | info | debug | trace
# FEISHU_LONG_CONNECTION_LOGGER_LEVEL=info
